{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/scan",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/scan",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "app/api/cron/scan/route.ts": {
      "maxDuration": 300
    },
    "app/api/scan/route.ts": {
      "maxDuration": 300
    },
    "app/api/geo/route.ts": {
      "maxDuration": 300
    }
  }
}
