# --- AI providers ---
# Primary: Vercel AI Gateway (https://vercel.com/dashboard/ai-gateway)
AI_GATEWAY_API_KEY=
# Model used through the AI Gateway (provider/model slug)
AI_MODEL=openai/gpt-4o-mini

# Automatic fallbacks (tried in this order when the Gateway fails or is
# unconfigured; any subset works): DeepSeek -> Tongyi qwen-max ->
# Moonshot kimi-k3 -> GLM-4-flash. All OpenAI-compatible.
DEEPSEEK_API_KEY=
TONGYI_API_KEY=
MOONSHOT_API_KEY=
GLM_API_KEY=

# --- Persistence (either one works; Postgres preferred) ---
# Neon Postgres connection string (a single JSONB KV table `autopilot_kv` is auto-created)
DATABASE_URL=
# Vercel Blob fallback (auto-set when you create a Blob store on Vercel)
BLOB_READ_WRITE_TOKEN=

# --- Cron protection ---
# Set to a long random string; Vercel Cron / GitHub Actions send it as the Bearer token.
CRON_SECRET=

# --- Target site pages to audit (comma separated). Defaults to the Mingxin core pages. ---
# TARGET_URLS=https://mingxinstorage.xyz/,https://mingxinstorage.xyz/en,https://mingxinstorage.xyz/products,https://mingxinstorage.xyz/solutions,https://mingxinstorage.xyz/evidence,https://mingxinstorage.xyz/faq

# Public base URL of the target site (used for sitemap/robots checks)
# TARGET_ORIGIN=https://mingxinstorage.xyz

# ============ GEO (Generative Engine Optimization, 4-step loop) ============
# Master switch for the GEO cycle (default: true)
GEO_ENABLED=true
# Articles produced per 4-hour cycle (default: 1 => 6 articles/day)
GEO_ARTICLES_PER_RUN=1
# Optional overrides for the keyword miner / writer context.
# The built-in default is the factual Mingxin FX-series context with report IDs (R1-R9).
# GEO_PRODUCT_CONTEXT=
# GEO_TARGET_MARKET=

# --- Dev.to (https://dev.to/settings/extensions -> Generate API Key) ---
DEVTO_API_KEY=

# --- Hashnode (https://hashnode.com/settings/developer -> PAT; publication id from your blog dashboard URL) ---
HASHNODE_PAT=
HASHNODE_PUBLICATION_ID=

# --- Reddit script app (https://www.reddit.com/prefs/apps -> create "script" app) ---
# Posts to the account's own profile (u_<username>) — compliant, no subreddit rules involved.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- GA4 (Step 4: traffic-signal detection, optional) ---
# The Mingxin site does not currently run GA4; leave these empty and the signal
# panel will show "not configured" while the other three GEO steps run normally.
# GA4 property id (NUMERIC, from Admin -> Property Settings) for reading reports.
# Grant the service account "Viewer" on the property.
GA4_PROPERTY_ID=
# Base64-encoded service-account JSON (or the raw JSON string)
GA4_SERVICE_ACCOUNT_JSON=
