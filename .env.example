# --- Vercel AI Gateway (required for AI-generated optimizations) ---
# Create a key at https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Model to use through the AI Gateway (provider/model slug)
AI_MODEL=openai/gpt-4o-mini

# --- Vercel Blob (auto-set when you create a Blob store on Vercel) ---
BLOB_READ_WRITE_TOKEN=

# --- Cron protection ---
# Set to a long random string; Vercel Cron sends it as the Bearer token.
CRON_SECRET=

# --- Target site(s) to optimize (comma separated) ---
TARGET_URLS=https://goni.top/zh/index.html,https://goni.top/en/index.html

# Public base URL of the target site (used for sitemap/robots checks)
TARGET_ORIGIN=https://goni.top

# ============ Writeback (auto-commit SEO fixes to the site's source repo) ============
# GitHub PAT with contents:write on the target repo. Also used by the GEO blog publisher.
GITHUB_TOKEN=
# owner/name of the goni.top source repository
GONI_REPO=bistuwangqiyuan/zhongke-dpu-official
GONI_BRANCH=main
# Publish dir relative to repo root ("." for root)
GONI_PUBLISH_DIR=.
SEO_WRITEBACK_ENABLED=false
SEO_WRITEBACK_DRYRUN=true
# Optional explicit URL->file mapping: "url=path,url=path"
# GONI_PAGE_FILES=

# ============ GEO (Generative Engine Optimization, 4-step loop) ============
# Master switch for the GEO cycle (default: true)
GEO_ENABLED=true
# Articles produced per 4-hour cycle (default: 1 => 6 articles/day)
GEO_ARTICLES_PER_RUN=1
# Optional overrides for the keyword miner context
# GEO_PRODUCT_CONTEXT=
# GEO_TARGET_MARKET=

# --- Dev.to (https://dev.to/settings/extensions -> Generate API Key) ---
DEVTO_API_KEY=

# --- Hashnode (https://hashnode.com/settings/developer -> PAT; publication id from your blog dashboard URL) ---
HASHNODE_PAT=
HASHNODE_PUBLICATION_ID=

# --- Reddit script app (https://www.reddit.com/prefs/apps -> create "script" app) ---
# Posts to the account's own profile (u_<username>) — compliant, no subreddit rules involved.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- GA4 traffic-signal detection (Step 4) ---
# GA4 property id (numeric). Grant the service account "Viewer" on the property.
GA4_PROPERTY_ID=
# Base64-encoded service-account JSON (or the raw JSON string)
GA4_SERVICE_ACCOUNT_JSON=
